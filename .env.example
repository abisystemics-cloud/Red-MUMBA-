# Copier en .env (jamais commité). En CI/CD : secrets GitHub / Render / AWS SSM.

# --- Hyperliquid -------------------------------------------------------------
# Adresse PUBLIQUE du compte principal qui détient les fonds
HL_ACCOUNT_ADDRESS=0x0000000000000000000000000000000000000000
# Clé privée de l'API WALLET (agent) — peut trader, ne peut PAS retirer.
# Créée sur app.hyperliquid.xyz → More → API. Ne JAMAIS mettre la clé du compte principal.
HL_API_WALLET_PRIVATE_KEY=
# Optionnel : fournisseur de carnet 100 niveaux compatible l2Book (ex. Dwellir)
HL_BOOK_WS_URL=

# Verrou du trading réel sur mainnet (en plus de network=mainnet et dry_run=false)
LIVE_TRADING_CONFIRM=

# --- Données externes --------------------------------------------------------
# Coinversa Pulse : positionnement des catégories de traders + carte des liquidations
COINVERSA_API_KEY=
COINGLASS_API_KEY=
FIRECRAWL_API_KEY=
PERPLEXITY_API_KEY=

# --- PostHog -----------------------------------------------------------------
POSTHOG_API_KEY=            # clé projet (phc_...) pour l'ingestion
POSTHOG_PERSONAL_API_KEY=   # clé perso (phx_...) pour les requêtes HogQL de l'agent R&D
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=           # ex. https://eu.posthog.com (défaut déduit de telemetry.posthog_host)

# --- Canal de supervision (commandes lues sur la branche GitHub `control`) ----
# Jeton GitHub "fine-grained" : ce dépôt uniquement, permission Contents = Read-only.
CONTROL_GITHUB_REPO=abisystemics-cloud/Red-MUMBA-
CONTROL_GITHUB_TOKEN=

# --- Alertes Telegram ---------------------------------------------------------
# Bot créé via @BotFather ; chat id obtenu via https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Interface web temps réel (http://<serveur>:8080/) --------------------------
# Obligatoire pour activer l'interface ; long et unique (c'est la clé des boutons de contrôle).
UI_PASSWORD=

LOG_LEVEL=INFO

# --- Import historique (scripts/import_history.py, workflow backtest) ---------
# Utilisateur IAM avec lecture S3 ; le transfert depuis l'archive Hyperliquid est
# facturé au demandeur (~0,09 $/Go).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
